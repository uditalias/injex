{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "alwaysStrict": true,
        "importHelpers": false,
        "target": "ES2020",
        "noImplicitAny": false,
        "sourceMap": true,
        "experimentalDecorators": false,
        "emitDecoratorMetadata": false,
        "moduleResolution": "node",
        "allowJs": false,
        "preserveConstEnums": true,
        "lib": [
			"ES2020",
			"dom",
			"esnext.decorators"
        ]
    },
    "compileOnSave": false
}